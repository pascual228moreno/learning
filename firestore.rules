rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperadminEmail() {
      return isSignedIn() && request.auth.token.email == '1.del.198333@gmail.com';
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperadmin() {
      return isSuperadminEmail() ||
        (hasUserDoc() && userDoc(request.auth.uid).role == 'superadmin');
    }

    function isAllowed() {
      return isSuperadminEmail() || hasUserDoc();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users
    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperadmin();
      allow list: if isSuperadmin();

      // Bootstrap: hardcoded superadmin email can self-create as superadmin.
      // Otherwise only an existing superadmin can create user docs.
      allow create: if isSuperadmin() ||
        (isOwner(userId) && isSuperadminEmail() &&
         request.resource.data.role == 'superadmin');

      // Self can update profile fields but never role or courseIds.
      // Superadmin can update anything.
      allow update: if isSuperadmin() ||
        (isOwner(userId) &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.courseIds == resource.data.courseIds);

      allow delete: if isSuperadmin();
    }

    // Courses (read-only public for now; admin via console)
    match /courses/{courseId} {
      allow read: if true;
      allow write: if false;
    }

    // Progress
    match /progress/{progressId} {
      allow get: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isSuperadmin());
      allow list: if isSuperadmin() || isAllowed();
      allow create, update: if isAllowed() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isSuperadmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Comments
    match /comments/{commentId} {
      allow list, get: if isAllowed();
      allow create: if isAllowed() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSuperadmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
